{
  "schemaVersion": 1,
  "id": "ehc",
  "version": "${version}",
  "name": "Eddy's Heart Containers",
  "description": "Adds the Heart Containers and Heart Pieces from the Zelda series, the simple way.",
  "authors": [
    "Eddy"
  ],
  "contact": {
    "issues": "https://github.com/EddyFrc/mc-heart-container/issues",
    "sources": "https://github.com/EddyFrc/mc-heart-container",
    "discord": "https://discord.com/invite/7nXgfjp9uu"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/ehc/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "fr.tayaut.ehc.client.HeartContainerDataGenerator"
    ],
    "client": [
      "fr.tayaut.ehc.client.HeartContainerClient"
    ],
    "main": [
      "fr.tayaut.ehc.EddysHeartContainer"
    ]
  },
  "mixins": [
    "ehc.mixins.json",
    {
      "config": "ehc.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
